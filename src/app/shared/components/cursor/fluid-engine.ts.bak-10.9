interface Particle{
x:number;
y:number;
px:number;
py:number;
vx:number;
vy:number;
age:number;
life:number;
size:number;
side:number;
seed:number;
energy:number;
}
export class FluidEngine{
private ctx:CanvasRenderingContext2D;
private particles:Particle[]=[];
private frame=0;
private running=true;
private dpr=1;
private last=performance.now();
private time=0;
private initialized=false;
private mx=0;
private my=0;
private sx=0;
private sy=0;
private pmx=0;
private pmy=0;
private lastEmitX=0;
private lastEmitY=0;
constructor(private canvas:HTMLCanvasElement){
const ctx=canvas.getContext('2d',{alpha:true,desynchronized:true});
if(!ctx)throw new Error('Canvas unavailable');
this.ctx=ctx;
this.resize();
this.loop();
}
resize(){
this.dpr=Math.min(devicePixelRatio||1,1.5);
const w=Math.max(1,Math.floor(innerWidth*this.dpr));
const h=Math.max(1,Math.floor(innerHeight*this.dpr));
if(this.canvas.width===w&&this.canvas.height===h)return;
this.canvas.width=w;
this.canvas.height=h;
this.canvas.style.width=`${innerWidth}px`;
this.canvas.style.height=`${innerHeight}px`;
}
move(x:number,y:number){
this.mx=x;
this.my=y;
if(!this.initialized){
this.initialized=true;
this.sx=x;
this.sy=y;
this.pmx=x;
this.pmy=y;
this.lastEmitX=x;
this.lastEmitY=y;
return;
}
this.sx+=(x-this.sx)*.48;
this.sy+=(y-this.sy)*.48;
const dx=this.sx-this.pmx;
const dy=this.sy-this.pmy;
const distance=Math.hypot(dx,dy);
if(distance>.35){
const steps=Math.max(1,Math.ceil(distance/5));
for(let i=1;i<=steps;i++){
const t=i/steps;
const ex=this.pmx+dx*t;
const ey=this.pmy+dy*t;
this.emit(ex,ey,dx,dy);
}
}
this.pmx=this.sx;
this.pmy=this.sy;
}
burst(x:number,y:number){
for(let i=0;i<55;i++){
const a=Math.PI*2*i/55;
const speed=1.2+Math.random()*3.5;
this.particles.push({
x,y,px:x,py:y,
vx:Math.cos(a)*speed,
vy:Math.sin(a)*speed,
age:0,
life:42+Math.random()*28,
size:.6+Math.random()*1.6,
side:Math.sin(a),
seed:Math.random()*1000,
energy:.45+Math.random()*.55
});
}
this.trim();
}
private emit(x:number,y:number,dx:number,dy:number){
const speed=Math.hypot(dx,dy);
if(speed<.01)return;
const tx=dx/speed;
const ty=dy/speed;
const nx=-ty;
const ny=tx;
const velocity=Math.min(speed,35);

/*
A cross-section of particles is emitted instead of one line.

Most particles occupy thin separated bands.
That creates a broad affected region without filling it.
*/
const bands=[
[-42,.13,1.0],
[-29,.20,1.15],
[-17,.32,1.25],
[-8,.48,1.35],
[-3,.74,1.45],
[0,1,1.6],
[3,.74,1.45],
[9,.46,1.3],
[18,.30,1.2],
[30,.19,1.1],
[43,.12,1.0]
];

for(let b=0;b<bands.length;b++){
const [offset,energy,size]=bands[b];
const count=b===5?3:1;
for(let n=0;n<count;n++){
const jitter=(Math.random()-.5)*(b===5?2.2:4.5);
const o=offset+jitter;
const px=x+nx*o;
const py=y+ny*o;
const spread=(Math.random()-.5)*.55;
this.particles.push({
x:px,
y:py,
px,
py,
vx:tx*(velocity*.075)+nx*spread,
vy:ty*(velocity*.075)+ny*spread,
age:0,
life:58+Math.random()*34,
size:size*(.82+Math.random()*.4),
side:Math.sign(offset)||0,
seed:Math.random()*1000,
energy
});
}
}

/*
Sparse membrane particles occupy the space between bands,
but with very low energy. These produce translucent folds,
not an opaque cloud.
*/
for(let i=0;i<3;i++){
const o=(Math.random()-.5)*92;
const px=x+nx*o;
const py=y+ny*o;
this.particles.push({
x:px,y:py,px,py,
vx:tx*(velocity*.045)+nx*(Math.random()-.5)*.3,
vy:ty*(velocity*.045)+ny*(Math.random()-.5)*.3,
age:0,
life:50+Math.random()*40,
size:.45+Math.random()*.5,
side:Math.sign(o),
seed:Math.random()*1000,
energy:.055+Math.random()*.055
});
}
this.trim();
}
private trim(){
if(this.particles.length>2800){
this.particles.splice(0,this.particles.length-2800);
}
}
private hash(x:number){
return Math.sin(x*12.9898+78.233)*43758.5453%1;
}
private field(x:number,y:number,seed:number){
const scale=.0065;
const X=x*scale;
const Y=y*scale;
const t=this.time*.22;

/*
Several smooth vector fields are combined.
No repeating path sine wave exists here.
*/
const a=
Math.sin(Y*1.7+t+seed*.013)+
Math.cos(X*1.25-t*.73+seed*.009);

const b=
Math.sin((X+Y)*.83-t*.41+seed*.017)+
Math.cos((X-Y)*.67+t*.31);

const angle=(a*.72+b*.38)*Math.PI;

return{
x:Math.cos(angle),
y:Math.sin(angle)
};
}
private update(dt:number){
for(const p of this.particles){
p.age+=dt;
p.px=p.x;
p.py=p.y;
const f=this.field(p.x,p.y,p.seed);

/*
Curl-field influence increases as the particle ages.
This lets the head begin coherent and the tail develop
large organic folds and spirals.
*/
const life=p.age/p.life;
const curl=.018+life*.055;
p.vx+=f.x*curl*dt;
p.vy+=f.y*curl*dt;

/*
Slow rotational force around nearby cursor trajectory.
This is what allows genuine whorls instead of parallel ribbons.
*/
const dx=p.x-this.sx;
const dy=p.y-this.sy;
const d=Math.hypot(dx,dy)+1;
if(d<190){
const influence=(1-d/190)*.018;
p.vx+=(-dy/d)*influence*p.side*dt;
p.vy+=(dx/d)*influence*p.side*dt;
}

p.vx*=Math.pow(.982,dt);
p.vy*=Math.pow(.982,dt);
p.x+=p.vx*dt;
p.y+=p.vy*dt;
}
this.particles=this.particles.filter(p=>p.age<p.life);
}
private color(p:Particle,alpha:number){
if(p.energy>.8)return`rgba(239,249,255,${alpha})`;
if(p.side<-.25)return`rgba(189,91,255,${alpha})`;
if(p.side>.25)return`rgba(71,198,255,${alpha})`;
return`rgba(151,107,255,${alpha})`;
}
private render(){
const ctx=this.ctx;
ctx.setTransform(this.dpr,0,0,this.dpr,0,0);
ctx.clearRect(0,0,innerWidth,innerHeight);
ctx.save();
ctx.globalCompositeOperation='lighter';

/*
PASS 1
Very faint membrane traces.

These occupy the broad region but remain nearly transparent.
*/
ctx.lineCap='round';
ctx.lineJoin='round';
for(const p of this.particles){
const life=p.age/p.life;
const fade=Math.pow(1-life,1.7);
if(fade<=.01)continue;
if(p.energy>.14)continue;
const alpha=fade*p.energy*.22;
ctx.beginPath();
ctx.moveTo(p.px,p.py);
ctx.lineTo(p.x,p.y);
ctx.lineWidth=2.2+p.size*2;
ctx.strokeStyle=this.color(p,alpha);
ctx.shadowBlur=7;
ctx.shadowColor=this.color(p,alpha*.8);
ctx.stroke();
}

/*
PASS 2
Colored liquid filaments.

There are many separate streams with empty space between them.
*/
for(const p of this.particles){
if(p.energy<=.14||p.energy>.79)continue;
const life=p.age/p.life;
const fade=Math.pow(1-life,1.35);
if(fade<=.01)continue;
const alpha=fade*p.energy*.36;
ctx.beginPath();
ctx.moveTo(p.px,p.py);
ctx.lineTo(p.x,p.y);
ctx.lineWidth=p.size*(1.1+p.energy*1.4);
ctx.strokeStyle=this.color(p,alpha);
ctx.shadowBlur=5+p.energy*8;
ctx.shadowColor=this.color(p,alpha*.9);
ctx.stroke();
}

/*
PASS 3
Condensed luminous river.

Only the highest-energy center particles enter this pass.
This creates the narrow white/cyan core seen in the target.
*/
for(const p of this.particles){
if(p.energy<=.79)continue;
const life=p.age/p.life;
const fade=Math.pow(1-life,1.18);
if(fade<=.01)continue;
ctx.beginPath();
ctx.moveTo(p.px,p.py);
ctx.lineTo(p.x,p.y);
ctx.lineWidth=4.8*p.size;
ctx.strokeStyle=this.color(p,fade*.045);
ctx.shadowBlur=22;
ctx.shadowColor='rgba(118,96,255,.24)';
ctx.stroke();
ctx.beginPath();
ctx.moveTo(p.px,p.py);
ctx.lineTo(p.x,p.y);
ctx.lineWidth=2.15*p.size;
ctx.strokeStyle=`rgba(135,225,255,${fade*.30})`;
ctx.shadowBlur=10;
ctx.shadowColor='rgba(89,211,255,.42)';
ctx.stroke();
ctx.beginPath();
ctx.moveTo(p.px,p.py);
ctx.lineTo(p.x,p.y);
ctx.lineWidth=.72*p.size;
ctx.strokeStyle=`rgba(255,255,255,${fade*.82})`;
ctx.shadowBlur=4;
ctx.shadowColor='rgba(255,255,255,.72)';
ctx.stroke();
}
ctx.restore();
this.drawHead();
}
private drawHead(){
if(!this.initialized)return;
const ctx=this.ctx;
const g=ctx.createRadialGradient(
this.sx,this.sy,0,
this.sx,this.sy,24
);
g.addColorStop(0,'rgba(255,255,255,.96)');
g.addColorStop(.08,'rgba(225,250,255,.88)');
g.addColorStop(.22,'rgba(98,219,255,.42)');
g.addColorStop(.45,'rgba(173,82,255,.20)');
g.addColorStop(.72,'rgba(238,64,221,.07)');
g.addColorStop(1,'rgba(90,60,255,0)');
ctx.save();
ctx.globalCompositeOperation='lighter';
ctx.fillStyle=g;
ctx.beginPath();
ctx.arc(this.sx,this.sy,24,0,Math.PI*2);
ctx.fill();
ctx.restore();
}
private loop=()=>{
if(!this.running)return;
const now=performance.now();
const dt=Math.min((now-this.last)/16.667,1.8);
this.last=now;
this.time=now*.001;
this.resize();
this.update(dt);
this.render();
this.frame=requestAnimationFrame(this.loop);
}
destroy(){
this.running=false;
cancelAnimationFrame(this.frame);
}
}
