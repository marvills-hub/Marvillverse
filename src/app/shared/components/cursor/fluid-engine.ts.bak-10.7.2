interface Point{
x:number;
y:number;
vx:number;
vy:number;
speed:number;
age:number;
life:number;
}

interface Sample{
x:number;
y:number;
nx:number;
ny:number;
speed:number;
age:number;
life:number;
turn:number;
}

export class FluidEngine{
private ctx:CanvasRenderingContext2D;
private points:Point[]=[];
private frame=0;
private running=true;
private last=performance.now();
private lastX=0;
private lastY=0;
private smoothX=0;
private smoothY=0;
private initialized=false;
private time=0;
private dpr=1;

constructor(private canvas:HTMLCanvasElement){
const ctx=canvas.getContext('2d',{
alpha:true,
desynchronized:true
});
if(!ctx)throw new Error('Canvas 2D unavailable');
this.ctx=ctx;
this.resize();
this.loop();
}

resize(){
this.dpr=Math.min(devicePixelRatio||1,1.5);
const w=Math.max(1,Math.floor(innerWidth*this.dpr));
const h=Math.max(1,Math.floor(innerHeight*this.dpr));
if(this.canvas.width===w&&this.canvas.height===h)return;
this.canvas.width=w;
this.canvas.height=h;
this.canvas.style.width=`${innerWidth}px`;
this.canvas.style.height=`${innerHeight}px`;
}

move(x:number,y:number){
if(!this.initialized){
this.initialized=true;
this.lastX=x;
this.lastY=y;
this.smoothX=x;
this.smoothY=y;
for(let i=0;i<5;i++)this.add(x,y,0,0);
return;
}

const rawDx=x-this.lastX;
const rawDy=y-this.lastY;

this.smoothX+=(x-this.smoothX)*.72;
this.smoothY+=(y-this.smoothY)*.72;

const dx=this.smoothX-this.lastX;
const dy=this.smoothY-this.lastY;
const distance=Math.hypot(dx,dy);

if(distance>.45){
const steps=Math.max(1,Math.ceil(distance/8));

for(let i=1;i<=steps;i++){
const t=i/steps;
this.add(
this.lastX+dx*t,
this.lastY+dy*t,
rawDx,
rawDy
);
}
}

this.lastX=this.smoothX;
this.lastY=this.smoothY;
}

burst(x:number,y:number){
for(let i=0;i<10;i++){
const a=i/10*Math.PI*2;
const r=5+i*.8;

this.points.unshift({
x:x+Math.cos(a)*r,
y:y+Math.sin(a)*r,
vx:Math.cos(a)*8,
vy:Math.sin(a)*8,
speed:8,
age:0,
life:42
});
}
}

private add(x:number,y:number,vx:number,vy:number){
const speed=Math.min(Math.hypot(vx,vy),60);

this.points.unshift({
x,
y,
vx,
vy,
speed,
age:0,
life:62
});

if(this.points.length>110)this.points.length=110;
}

private sample():Sample[]{
if(this.points.length<4)return[];

const src=this.points;
const result:Sample[]=[];

for(let i=0;i<src.length-2;i++){
const p0=src[Math.max(0,i-1)];
const p1=src[i];
const p2=src[i+1];
const p3=src[Math.min(src.length-1,i+2)];

for(let j=0;j<2;j++){
const t=j/2;
const t2=t*t;
const t3=t2*t;

const x=.5*(
(2*p1.x)+
(-p0.x+p2.x)*t+
(2*p0.x-5*p1.x+4*p2.x-p3.x)*t2+
(-p0.x+3*p1.x-3*p2.x+p3.x)*t3
);

const y=.5*(
(2*p1.y)+
(-p0.y+p2.y)*t+
(2*p0.y-5*p1.y+4*p2.y-p3.y)*t2+
(-p0.y+3*p1.y-3*p2.y+p3.y)*t3
);

const dx=.5*(
(-p0.x+p2.x)+
2*(2*p0.x-5*p1.x+4*p2.x-p3.x)*t+
3*(-p0.x+3*p1.x-3*p2.x+p3.x)*t2
);

const dy=.5*(
(-p0.y+p2.y)+
2*(2*p0.y-5*p1.y+4*p2.y-p3.y)*t+
3*(-p0.y+3*p1.y-3*p2.y+p3.y)*t2
);

const len=Math.hypot(dx,dy)||1;
const nx=-dy/len;
const ny=dx/len;

const ax=p1.x-p0.x;
const ay=p1.y-p0.y;
const bx=p2.x-p1.x;
const by=p2.y-p1.y;

const al=Math.hypot(ax,ay)||1;
const bl=Math.hypot(bx,by)||1;

const cross=
(ax/al)*(by/bl)-
(ay/al)*(bx/bl);

const dot=
(ax/al)*(bx/bl)+
(ay/al)*(by/bl);

result.push({
x,
y,
nx,
ny,
speed:p1.speed,
age:p1.age,
life:p1.life,
turn:Math.atan2(cross,dot)
});
}
}

return result;
}

private trace(
samples:Sample[],
offset:number,
wave:number,
phase:number
){
const ctx=this.ctx;

ctx.beginPath();

for(let i=0;i<samples.length;i++){
const p=samples[i];

const fade=
Math.max(0,1-p.age/p.life);

const oscillation=
Math.sin(i*.42+this.time*phase)*
wave*
fade;

const curl=
Math.sin(i*.18-this.time*.75)*
Math.abs(p.turn)*
35*
fade;

const o=
offset+
oscillation+
curl;

const x=p.x+p.nx*o;
const y=p.y+p.ny*o;

if(i===0)ctx.moveTo(x,y);
else ctx.lineTo(x,y);
}
}

private stroke(
samples:Sample[],
offset:number,
wave:number,
phase:number,
width:number,
alpha:number,
blur:number,
colorA:string,
colorB:string
){
if(samples.length<2)return;

const ctx=this.ctx;
const first=samples[0];
const last=samples[samples.length-1];

const gradient=
ctx.createLinearGradient(
last.x,
last.y,
first.x,
first.y
);

gradient.addColorStop(
0,
'rgba(70,45,180,0)'
);

gradient.addColorStop(
.18,
colorA
);

gradient.addColorStop(
.70,
colorB
);

gradient.addColorStop(
1,
'rgba(255,255,255,.96)'
);

ctx.save();

ctx.globalCompositeOperation='lighter';
ctx.globalAlpha=alpha;
ctx.lineCap='round';
ctx.lineJoin='round';
ctx.lineWidth=width;
ctx.strokeStyle=gradient;
ctx.shadowBlur=blur;
ctx.shadowColor=colorB;

this.trace(
samples,
offset,
wave,
phase
);

ctx.stroke();

ctx.restore();
}

private membrane(
samples:Sample[],
offset:number,
width:number,
wave:number,
phase:number,
alpha:number,
color:string
){
if(samples.length<3)return;

const ctx=this.ctx;
const shape=new Path2D();

for(let i=0;i<samples.length;i++){
const p=samples[i];

const fade=
Math.max(0,1-p.age/p.life);

const wobble=
Math.sin(
i*.31+
this.time*phase
)*
wave*
fade;

const curl=
Math.sin(
i*.16-
this.time*.65
)*
Math.abs(p.turn)*
22*
fade;

const o=
offset-
width*.5+
wobble+
curl;

const x=
p.x+
p.nx*o;

const y=
p.y+
p.ny*o;

if(i===0)shape.moveTo(x,y);
else shape.lineTo(x,y);
}

for(let i=samples.length-1;i>=0;i--){
const p=samples[i];

const fade=
Math.max(0,1-p.age/p.life);

const wobble=
Math.sin(
i*.27+
this.time*(phase*.83)+
1.7
)*
wave*
fade;

const curl=
Math.cos(
i*.14-
this.time*.58
)*
Math.abs(p.turn)*
18*
fade;

const o=
offset+
width*.5+
wobble+
curl;

shape.lineTo(
p.x+p.nx*o,
p.y+p.ny*o
);
}

shape.closePath();

const first=samples[0];
const last=samples[samples.length-1];

const gradient=
ctx.createLinearGradient(
last.x,
last.y,
first.x,
first.y
);

gradient.addColorStop(
0,
'rgba(70,35,170,0)'
);

gradient.addColorStop(
.22,
'rgba(84,57,210,.018)'
);

gradient.addColorStop(
.55,
color
);

gradient.addColorStop(
.82,
'rgba(103,170,255,.032)'
);

gradient.addColorStop(
1,
'rgba(255,255,255,.07)'
);

ctx.save();

ctx.globalCompositeOperation='lighter';
ctx.globalAlpha=alpha;
ctx.fillStyle=gradient;

ctx.fill(shape);

ctx.globalAlpha=alpha*1.7;
ctx.lineWidth=.55;
ctx.strokeStyle=
'rgba(174,132,255,.22)';
ctx.shadowBlur=7;
ctx.shadowColor=
'rgba(108,73,255,.25)';

ctx.stroke(shape);

ctx.restore();
}

private head(samples:Sample[]){
if(!samples.length)return;

const p=samples[0];
const ctx=this.ctx;

const g=
ctx.createRadialGradient(
p.x,p.y,0,
p.x,p.y,24
);

g.addColorStop(
0,
'rgba(255,255,255,.98)'
);

g.addColorStop(
.08,
'rgba(213,249,255,.90)'
);

g.addColorStop(
.22,
'rgba(98,220,255,.44)'
);

g.addColorStop(
.48,
'rgba(151,83,255,.21)'
);

g.addColorStop(
.72,
'rgba(255,73,220,.07)'
);

g.addColorStop(
1,
'rgba(100,70,255,0)'
);

ctx.save();

ctx.globalCompositeOperation='lighter';
ctx.fillStyle=g;

ctx.beginPath();
ctx.arc(
p.x,
p.y,
24,
0,
Math.PI*2
);

ctx.fill();

ctx.restore();
}

private render(){
const ctx=this.ctx;

ctx.setTransform(
this.dpr,
0,
0,
this.dpr,
0,
0
);

ctx.clearRect(
0,
0,
innerWidth,
innerHeight
);

const s=this.sample();

if(s.length<3)return;

/*
THIN TRANSPARENT OUTER SHEETS
*/

this.membrane(
s,
-31,
46,
11,
1.13,
.105,
'rgba(121,76,255,.038)'
);

this.membrane(
s,
25,
37,
9,
.91,
.095,
'rgba(42,182,255,.034)'
);

this.membrane(
s,
-8,
25,
7,
1.37,
.10,
'rgba(238,68,255,.032)'
);

/*
SEPARATED FINE FILAMENTS
*/

this.stroke(
s,
-31,
6,
1.15,
1.05,
.23,
7,
'rgba(92,72,255,.07)',
'rgba(194,91,255,.43)'
);

this.stroke(
s,
23,
5,
.92,
.90,
.22,
6,
'rgba(52,105,255,.06)',
'rgba(62,214,255,.40)'
);

this.stroke(
s,
-14,
3.5,
1.43,
1.25,
.25,
7,
'rgba(120,62,255,.08)',
'rgba(255,78,219,.43)'
);

this.stroke(
s,
12,
2.8,
1.72,
.68,
.20,
4,
'rgba(56,165,255,.06)',
'rgba(141,225,255,.37)'
);

/*
CONDENSED MAIN ENERGY STREAM
*/

this.stroke(
s,
0,
2.5,
1.04,
8,
.055,
21,
'rgba(79,62,255,.08)',
'rgba(171,74,255,.18)'
);

this.stroke(
s,
0,
1.8,
1.04,
4.2,
.22,
13,
'rgba(100,75,255,.18)',
'rgba(76,210,255,.55)'
);

this.stroke(
s,
0,
1.0,
1.04,
2,
.59,
7,
'rgba(150,92,255,.48)',
'rgba(132,232,255,.86)'
);

this.stroke(
s,
0,
.45,
1.04,
.82,
.88,
3,
'rgba(219,187,255,.72)',
'rgba(255,255,255,.98)'
);

this.head(s);
}

private loop=()=>{
if(!this.running)return;

const now=performance.now();

const dt=
Math.min(
(now-this.last)/16.667,
2
);

this.last=now;
this.time=now*.001;

this.resize();

for(const p of this.points){
p.age+=dt;

/*
Tiny residual motion only.
The ribbon fades rather than drifting away.
*/

p.x+=p.vx*.004*dt;
p.y+=p.vy*.004*dt;

p.vx*=Math.pow(.90,dt);
p.vy*=Math.pow(.90,dt);
}

this.points=
this.points.filter(
p=>p.age<p.life
);

this.render();

this.frame=
requestAnimationFrame(
this.loop
);
}

destroy(){
this.running=false;
cancelAnimationFrame(this.frame);
}
}
