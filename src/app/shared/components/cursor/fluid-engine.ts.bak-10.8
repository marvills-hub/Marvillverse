interface Point{
x:number;
y:number;
vx:number;
vy:number;
speed:number;
age:number;
life:number;
}
interface Sample{
x:number;
y:number;
nx:number;
ny:number;
speed:number;
age:number;
life:number;
turn:number;
distance:number;
}
export class FluidEngine{
private ctx:CanvasRenderingContext2D;
private points:Point[]=[];
private frame=0;
private running=true;
private last=performance.now();
private lastX=0;
private lastY=0;
private smoothX=0;
private smoothY=0;
private initialized=false;
private time=0;
private dpr=1;
constructor(private canvas:HTMLCanvasElement){
const ctx=canvas.getContext('2d',{alpha:true,desynchronized:true});
if(!ctx)throw new Error('Canvas 2D unavailable');
this.ctx=ctx;
this.resize();
this.loop();
}
resize(){
this.dpr=Math.min(devicePixelRatio||1,1.5);
const w=Math.max(1,Math.floor(innerWidth*this.dpr));
const h=Math.max(1,Math.floor(innerHeight*this.dpr));
if(this.canvas.width===w&&this.canvas.height===h)return;
this.canvas.width=w;
this.canvas.height=h;
this.canvas.style.width=`${innerWidth}px`;
this.canvas.style.height=`${innerHeight}px`;
}
move(x:number,y:number){
if(!this.initialized){
this.initialized=true;
this.lastX=x;
this.lastY=y;
this.smoothX=x;
this.smoothY=y;
for(let i=0;i<6;i++)this.add(x,y,0,0);
return;
}
const rawX=x-this.lastX;
const rawY=y-this.lastY;
this.smoothX+=(x-this.smoothX)*.34;
this.smoothY+=(y-this.smoothY)*.34;
const dx=this.smoothX-this.lastX;
const dy=this.smoothY-this.lastY;
const distance=Math.hypot(dx,dy);
if(distance>.3){
const steps=Math.max(1,Math.ceil(distance/4));
for(let i=1;i<=steps;i++){
const t=i/steps;
this.add(
this.lastX+dx*t,
this.lastY+dy*t,
rawX,
rawY
);
}
}
this.lastX=this.smoothX;
this.lastY=this.smoothY;
}
burst(x:number,y:number){
for(let i=0;i<7;i++){
const a=i/7*Math.PI*2;
this.points.unshift({
x:x+Math.cos(a)*3,
y:y+Math.sin(a)*3,
vx:Math.cos(a)*4,
vy:Math.sin(a)*4,
speed:4,
age:0,
life:35
});
}
}
private add(x:number,y:number,vx:number,vy:number){
this.points.unshift({
x,y,vx,vy,
speed:Math.min(Math.hypot(vx,vy),55),
age:0,
life:82
});
if(this.points.length>165)this.points.length=165;
}
private noise1(x:number){
const i=Math.floor(x);
const f=x-i;
const u=f*f*(3-2*f);
const a=this.hash(i);
const b=this.hash(i+1);
return a+(b-a)*u;
}
private hash(n:number){
const x=Math.sin(n*127.1+311.7)*43758.5453123;
return (x-Math.floor(x))*2-1;
}
private organic(
distance:number,
scale:number,
speed:number,
seed:number
){
const t=this.time*speed;
const a=this.noise1(distance*scale+t+seed);
const b=this.noise1(distance*scale*.47-t*.37+seed*2.31);
const c=this.noise1(distance*scale*.19+t*.18+seed*4.73);
return a*.52+b*.31+c*.17;
}
private sample():Sample[]{
if(this.points.length<4)return[];
const result:Sample[]=[];
let travelled=0;
let previousX=0;
let previousY=0;
let first=true;
for(let i=0;i<this.points.length-2;i++){
const p0=this.points[Math.max(0,i-1)];
const p1=this.points[i];
const p2=this.points[i+1];
const p3=this.points[Math.min(this.points.length-1,i+2)];
for(let j=0;j<3;j++){
const t=j/3;
const t2=t*t;
const t3=t2*t;
const x=.5*((2*p1.x)+(-p0.x+p2.x)*t+(2*p0.x-5*p1.x+4*p2.x-p3.x)*t2+(-p0.x+3*p1.x-3*p2.x+p3.x)*t3);
const y=.5*((2*p1.y)+(-p0.y+p2.y)*t+(2*p0.y-5*p1.y+4*p2.y-p3.y)*t2+(-p0.y+3*p1.y-3*p2.y+p3.y)*t3);
const dx=.5*((-p0.x+p2.x)+2*(2*p0.x-5*p1.x+4*p2.x-p3.x)*t+3*(-p0.x+3*p1.x-3*p2.x+p3.x)*t2);
const dy=.5*((-p0.y+p2.y)+2*(2*p0.y-5*p1.y+4*p2.y-p3.y)*t+3*(-p0.y+3*p1.y-3*p2.y+p3.y)*t2);
const len=Math.hypot(dx,dy)||1;
if(!first)travelled+=Math.hypot(x-previousX,y-previousY);
first=false;
previousX=x;
previousY=y;
const ax=p1.x-p0.x;
const ay=p1.y-p0.y;
const bx=p2.x-p1.x;
const by=p2.y-p1.y;
const al=Math.hypot(ax,ay)||1;
const bl=Math.hypot(bx,by)||1;
const cross=(ax/al)*(by/bl)-(ay/al)*(bx/bl);
const dot=(ax/al)*(bx/bl)+(ay/al)*(by/bl);
result.push({
x,y,
nx:-dy/len,
ny:dx/len,
speed:p1.speed,
age:p1.age,
life:p1.life,
turn:Math.atan2(cross,dot),
distance:travelled
});
}
}
return result;
}
private offset(
p:Sample,
base:number,
amount:number,
scale:number,
speed:number,
seed:number
){
const fade=Math.max(0,1-p.age/p.life);
const organic=this.organic(p.distance,scale,speed,seed)*amount;
const curvature=Math.max(-1,Math.min(1,p.turn*3.5));
const fold=curvature*amount*.55;
return (base+organic+fold)*fade;
}
private makePath(
samples:Sample[],
base:number,
amount:number,
scale:number,
speed:number,
seed:number
){
const path=new Path2D();
for(let i=0;i<samples.length;i++){
const p=samples[i];
const o=this.offset(p,base,amount,scale,speed,seed);
const x=p.x+p.nx*o;
const y=p.y+p.ny*o;
if(i===0)path.moveTo(x,y);
else path.lineTo(x,y);
}
return path;
}
private ribbon(
samples:Sample[],
offset:number,
width:number,
variation:number,
seed:number,
alpha:number,
inner:string,
outer:string,
blur:number
){
if(samples.length<4)return;
const shape=new Path2D();
for(let i=0;i<samples.length;i++){
const p=samples[i];
const fade=Math.max(0,1-p.age/p.life);
const widthNoise=this.organic(p.distance,.010,.10,seed+8);
const localWidth=width*(1+widthNoise*.42)*fade;
const center=this.offset(p,offset,variation,.008,.11,seed);
const o=center-localWidth*.5;
const x=p.x+p.nx*o;
const y=p.y+p.ny*o;
if(i===0)shape.moveTo(x,y);
else shape.lineTo(x,y);
}
for(let i=samples.length-1;i>=0;i--){
const p=samples[i];
const fade=Math.max(0,1-p.age/p.life);
const widthNoise=this.organic(p.distance,.009,.085,seed+19);
const localWidth=width*(1+widthNoise*.38)*fade;
const center=this.offset(p,offset,variation*.82,.007,.09,seed+31);
const o=center+localWidth*.5;
shape.lineTo(p.x+p.nx*o,p.y+p.ny*o);
}
shape.closePath();
const ctx=this.ctx;
const head=samples[0];
const tail=samples[samples.length-1];
const g=ctx.createLinearGradient(tail.x,tail.y,head.x,head.y);
g.addColorStop(0,'rgba(80,50,180,0)');
g.addColorStop(.15,'rgba(100,65,220,.01)');
g.addColorStop(.48,outer);
g.addColorStop(.78,inner);
g.addColorStop(1,'rgba(235,246,255,.12)');
ctx.save();
ctx.globalCompositeOperation='lighter';
ctx.globalAlpha=alpha;
ctx.fillStyle=g;
ctx.shadowBlur=blur;
ctx.shadowColor=inner;
ctx.fill(shape);
ctx.globalAlpha=alpha*.75;
ctx.lineWidth=.65;
ctx.strokeStyle=inner;
ctx.stroke(shape);
ctx.restore();
}
private filament(
samples:Sample[],
offset:number,
variation:number,
seed:number,
width:number,
alpha:number,
color1:string,
color2:string,
blur:number
){
if(samples.length<3)return;
const path=this.makePath(samples,offset,variation,.009,.105,seed);
const ctx=this.ctx;
const head=samples[0];
const tail=samples[samples.length-1];
const g=ctx.createLinearGradient(tail.x,tail.y,head.x,head.y);
g.addColorStop(0,'rgba(80,40,190,0)');
g.addColorStop(.18,color1);
g.addColorStop(.72,color2);
g.addColorStop(1,'rgba(255,255,255,.92)');
ctx.save();
ctx.globalCompositeOperation='lighter';
ctx.globalAlpha=alpha;
ctx.lineCap='round';
ctx.lineJoin='round';
ctx.lineWidth=width;
ctx.strokeStyle=g;
ctx.shadowBlur=blur;
ctx.shadowColor=color2;
ctx.stroke(path);
ctx.restore();
}
private render(){
const ctx=this.ctx;
ctx.setTransform(this.dpr,0,0,this.dpr,0,0);
ctx.clearRect(0,0,innerWidth,innerHeight);
const s=this.sample();
if(s.length<4)return;

/*
Large sheets:
wide spatial reach, extremely low opacity.
Their boundaries deform independently, so there are no
parallel/repeating sine waves.
*/
this.ribbon(
s,-26,54,18,14,.13,
'rgba(173,116,255,.10)',
'rgba(91,54,220,.035)',15
);
this.ribbon(
s,24,45,12,39,.12,
'rgba(97,218,255,.095)',
'rgba(42,111,255,.03)',14
);
this.ribbon(
s,-7,31,10,67,.11,
'rgba(255,104,224,.08)',
'rgba(151,72,255,.03)',12
);

/*
Independent silk filaments.
*/
this.filament(
s,-31,13,11,1.15,.18,
'rgba(116,78,255,.08)',
'rgba(203,112,255,.45)',8
);
this.filament(
s,27,11,43,1.05,.18,
'rgba(55,124,255,.07)',
'rgba(93,225,255,.42)',8
);
this.filament(
s,-15,8,83,1.4,.19,
'rgba(155,79,255,.10)',
'rgba(255,100,220,.43)',9
);
this.filament(
s,13,7,103,.95,.17,
'rgba(65,155,255,.08)',
'rgba(143,236,255,.42)',7
);

/*
Central silk river.

No jagged oscillation.
Each layer uses only very low-frequency organic displacement.
*/
this.filament(
s,0,5.5,131,16,.055,
'rgba(105,65,255,.08)',
'rgba(197,85,255,.20)',28
);
this.filament(
s,0,4.3,131,10,.12,
'rgba(122,80,255,.16)',
'rgba(85,198,255,.38)',20
);
this.filament(
s,0,3.2,131,6.2,.25,
'rgba(160,104,255,.31)',
'rgba(104,224,255,.59)',14
);
this.filament(
s,0,2.1,131,3.4,.48,
'rgba(205,163,255,.55)',
'rgba(190,245,255,.80)',9
);
this.filament(
s,0,1.2,131,1.25,.77,
'rgba(239,220,255,.76)',
'rgba(255,255,255,.98)',4
);

/*
Close companion streams make the center feel like
layered liquid rather than one glowing cable.
*/
this.filament(
s,6,3.8,151,2.3,.24,
'rgba(104,100,255,.20)',
'rgba(100,218,255,.56)',8
);
this.filament(
s,-7,4.1,177,2.1,.22,
'rgba(190,85,255,.22)',
'rgba(255,121,225,.48)',8
);

this.head(s);
}
private head(samples:Sample[]){
if(!samples.length)return;
const p=samples[0];
const ctx=this.ctx;
const g=ctx.createRadialGradient(p.x,p.y,0,p.x,p.y,20);
g.addColorStop(0,'rgba(255,255,255,.98)');
g.addColorStop(.09,'rgba(224,250,255,.88)');
g.addColorStop(.25,'rgba(105,220,255,.40)');
g.addColorStop(.48,'rgba(157,92,255,.18)');
g.addColorStop(.72,'rgba(244,80,226,.055)');
g.addColorStop(1,'rgba(100,70,255,0)');
ctx.save();
ctx.globalCompositeOperation='lighter';
ctx.fillStyle=g;
ctx.beginPath();
ctx.arc(p.x,p.y,20,0,Math.PI*2);
ctx.fill();
ctx.restore();
}
private loop=()=>{
if(!this.running)return;
const now=performance.now();
const dt=Math.min((now-this.last)/16.667,2);
this.last=now;
this.time=now*.001;
this.resize();
for(const p of this.points){
p.age+=dt;
p.x+=p.vx*.002*dt;
p.y+=p.vy*.002*dt;
p.vx*=Math.pow(.88,dt);
p.vy*=Math.pow(.88,dt);
}
this.points=this.points.filter(p=>p.age<p.life);
this.render();
this.frame=requestAnimationFrame(this.loop);
}
destroy(){
this.running=false;
cancelAnimationFrame(this.frame);
}
}
